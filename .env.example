# Narrekappe VM Deployer - Environment Configuration
# Copy this file to .env.local and fill in your values
# IMPORTANT: Never commit .env.local to version control!

# ===========================================
# PROXMOX CONNECTION SETTINGS
# ===========================================

# Proxmox server hostname or IP address
PROXMOX_HOST=192.168.205.30

# Proxmox root user (typically 'root')
PROXMOX_USER=root

# Proxmox authentication realm
PROXMOX_REALM=pve

# ===========================================
# AUTHENTICATION (Choose ONE method)
# ===========================================

# RECOMMENDED: SSH Key Authentication
# Generate with: ssh-keygen -t ed25519 -f /root/.ssh/proxmox_key
# Copy to Proxmox: ssh-copy-id -i /root/.ssh/proxmox_key.pub root@192.168.205.30
PROXMOX_SSH_KEY=/root/.ssh/proxmox_key

# ALTERNATIVE: Password Authentication (less secure)
# PROXMOX_PASSWORD=your_strong_password_here

# ===========================================
# SECURITY TOKENS
# ===========================================

# Cleanup API authentication token
# Generate with: openssl rand -hex 32
# Used for automated cleanup endpoint
CLEANUP_TOKEN=change_me_to_random_hex_32_characters

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Node environment (development or production)
NODE_ENV=production

# Application port (default: 3000)
# PORT=3000

# ===========================================
# OPTIONAL: ADVANCED SETTINGS
# ===========================================

# SSH connection timeout (milliseconds)
# SSH_TIMEOUT=30000

# VM session timeout (milliseconds)
# Default: 7200000 (2 hours)
# VM_SESSION_TIMEOUT=7200000

# Rate limit window (milliseconds)
# RATE_LIMIT_WINDOW=60000

# Maximum deployment requests per window
# RATE_LIMIT_MAX_DEPLOYS=3

# ===========================================
# FILE PERMISSIONS
# ===========================================
# After creating .env.local, run:
#   chmod 600 .env.local
#   chown root:root .env.local
